# Copy to .env (never committed) and fill in. Only PLM_LLM_API_KEY is required.
PLM_LLM_API_KEY=
PLM_LLM_BASE_URL=https://api.groq.com/openai/v1
PLM_LLM_MODEL=openai/gpt-oss-120b
PLM_AGENT_MAX_STEPS=6
PLM_AGENT_TEMPERATURE=0
PLM_LLM_TIMEOUT_S=30
PLM_LLM_MAX_RETRIES=5
# off | fallback (recorded answer if any, else live) | only (recorded answers, no key needed)
PLM_AGENT_REPLAY=off
PLM_AGENT_REPLAY_PATH=data/agent_replays/answers.json
